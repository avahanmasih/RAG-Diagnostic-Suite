# Python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/

# Virtual environments
venv/
env/
.venv/
.conda/

# Jupyter
.ipynb_checkpoints/
*.ipynb_meta

# Hugging Face / datasets cache (large, regenerable — never commit)
data/datasets/*
!data/datasets/.gitkeep
.cache/
huggingface/

# FAISS indices and large binary artifacts (regenerable from notebooks)
*.index
*.faiss
*.pkl
*.bin

# Results (regenerable — keep only curated final figures if you choose to commit them)
results/*
!results/visualizations/.gitkeep
!results/.gitkeep

# OS-specific
.DS_Store
Thumbs.db
desktop.ini

# Editor
.vscode/
.idea/

# Environment secrets (none expected in this project, but good hygiene)
.env
